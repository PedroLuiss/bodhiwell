{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block main %}
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">{{ 'withdrawal.bank_info_title'|trans }}</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col mb-2">
                            <strong>{{ 'users.professional'|trans }}:</strong><br>
                            {{ entity.instance.professional.firstName }} {{ entity.instance.professional.lastName }}
                        </div>
                        <div class="col mb-2">
                            <strong>{{ 'users.email'|trans }}:</strong><br>
                            {{ entity.instance.professional.email }}
                        </div>
                        <div class="col mb-2">
                            <strong>{{ 'users.holder_name'|trans }}:</strong><br>
                            {{ holderName|default('N/A') }}
                        </div>
                        <div class="col mb-2">
                            <strong>{{ 'users.account_number'|trans }}:</strong><br>
                            <span class="badge badge-info" style="font-size: 1.1em;">
                                {{ accountNumber|default('No registrado') }}
                            </span>
                        </div>
                        <div class="col mb-2">
                            <strong>{{ 'users.bank_name'|trans }}:</strong><br>
                            <span class="text-white">
                                {{ bankName|default('N/A') }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-7">
            <div class="card mb-4 h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Detalle del Retiro</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">ID</dt>
                        <dd class="col-sm-8">{{ entity.instance.id }}</dd>

                        <dt class="col-sm-4">Usuario</dt>
                        <dd class="col-sm-8">
                            <a href="{{ ea_url().setController('App\\Controller\\Admin\\UserProfessionalCrudController').setAction('detail').setEntityId(entity.instance.professional.id) }}">
                                {{ entity.instance.professional.getFullName() }}
                            </a>
                        </dd>

                        <dt class="col-sm-4">Motivo</dt>
                        <dd class="col-sm-8">{{ entity.instance.reason }}</dd>

                        <dt class="col-sm-4">Monto</dt>
                        <dd class="col-sm-8">${{ entity.instance.amount|number_format(2, ',', '.') }} UYU</dd>

                        <dt class="col-sm-4">Fecha</dt>
                        <dd class="col-sm-8">{{ entity.instance.createdAt|date('d M Y') }}</dd>

                        <dt class="col-sm-4">Estado</dt>
                        <dd class="col-sm-8">
                            {% set status = entity.instance.status.value %}
                            {% set color = 'secondary' %}
                            {% if status == 'pending' %}{% set color = 'warning' %}{% endif %}
                            {% if status == 'approved' %}{% set color = 'success' %}{% endif %}
                            {% if status == 'rejected' %}{% set color = 'danger' %}{% endif %}
                            {% if status == 'in_process' %}{% set color = 'info' %}{% endif %}
                            
                            <span class="badge badge-{{ color }}">
                                {{ ('withdrawal.status.' ~ status)|trans|upper }}
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card mb-4 h-100">
                <div class="card-header bg-dark text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Nota del Administrador</h5>
                        {% if entity.instance.status.value == 'approved' or entity.instance.status.value == 'rejected' %}
                            <span class="badge badge-light text-dark">Procesado</span>
                        {% endif %}
                    </div>
                </div>
                <div class="card-body">
                    {% if entity.instance.adminNote %}
                        <div class="p-3 rounded border border-secondary" style="background: rgba(255,255,255,0.05); min-height: 120px;">
                            {{ entity.instance.adminNote|nl2br }}
                        </div>
                    {% else %}
                        <div class="text-muted text-center py-4 d-flex flex-column align-items-center justify-content-center h-100">
                            <i class="fa fa-sticky-note-o fa-2x mb-2"></i>
                            <em>No hay nota registrada</em>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Reporte de Origen de Fondos (Auditoría)</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="thead-dark">
                            <tr>
                                <th>Fecha</th>
                                <th>Concepto</th>
                                <th>Monto Liberado</th>
                                <th>Detalle</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ledger in fundsOrigin %}
                                <tr>
                                    <td>{{ ledger.createdAt|date('Y-m-d H:i') }}</td>
                                    <td>{{ ledger.concept.label() }}</td>
                                    <td>${{ ledger.amount|number_format(2) }}</td>
                                    <td>
                                        {% if ledger.payment and ledger.payment.booking %}
                                            Reserva #{{ ledger.payment.booking.uid|slice(0,8) }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center p-3">
                                        <em>No se encontraron movimientos específicos en el rango de fechas.</em>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot class="bg-light font-weight-bold">
                            <tr>
                                <td colspan="2" class="text-right">Total Calculado:</td>
                                <td colspan="2">${{ totalCalculated|number_format(2) }}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
