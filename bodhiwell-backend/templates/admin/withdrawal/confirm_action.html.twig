{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}
    {{ page_title }}
{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-body">
                    <div class="alert alert-info">
                        <strong>Retiro:</strong> #{{ withdrawal.id }} - {{ withdrawal.professional.getFullName() }}<br>
                        <strong>Monto:</strong> ${{ withdrawal.amount|number_format(2) }} UYU<br>
                        <strong>Fecha:</strong> {{ withdrawal.date|date('Y-m-d') }}
                    </div>

                    <form method="post" action="{{ actionUrl }}">
                        <input type="hidden" name="token" value="{{ csrf_token('withdrawal_action') }}">
                        
                        <div class="form-group">
                            <label for="adminNote" class="form-control-label required">
                                Nota / Referencia (Obligatorio)
                            </label>
                            <textarea id="adminNote" name="note" class="form-control" rows="4" required placeholder="Ingrese una nota, número de referencia bancaria o motivo..."></textarea>
                            <small class="form-text text-muted">Esta nota quedará registrada en el historial del retiro.</small>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-{{ actionType == 'approve' ? 'success' : 'danger' }}">
                                <i class="fa fa-bf fa-check"></i> {{ actionLabel }}
                            </button>
                            <a href="{{ ea_url().setController('App\\Controller\\Admin\\WithdrawalCrudController').setAction('detail').setEntityId(withdrawal.id) }}" class="btn btn-secondary">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
