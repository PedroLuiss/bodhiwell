{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ page_title }}{% endblock %}

{% block main %}
    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-md-8 col-lg-6">
                <div class="card bg-dark border-secondary shadow-sm">
                    <div class="card-body p-4">
                        <h3 class="mb-3">{{ page_title }}</h3>
                        <p class="text-secondary mb-4">{{ help_text }}</p>

                        <form method="POST" enctype="multipart/form-data">
                            <div class="form-group mb-4">
                                <label for="batch_file" class="form-label text-light">Archivo de Especialidades (Excel o CSV)</label>
                                <input type="file" name="batch_file" id="batch_file" class="form-control bg-dark text-light border-secondary" accept=".xlsx, .xls, .csv" required>
                            </div>

                            <div class="d-flex align-items-center gap-3 mt-4">
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="fa fa-upload me-2"></i> Comenzar Importación
                                </button>
                                <a href="{{ ea_url().setController('App\\Controller\\Admin\\SpecialtyCrudController').setAction('index') }}" class="btn btn-outline-secondary">
                                    Cancelar
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
