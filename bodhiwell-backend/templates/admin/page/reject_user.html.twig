{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}{{ 'users.actions.reject_title'|trans({}, 'messages') }}{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-md-8 col-xl-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-4">{{ 'users.professional_singular'|trans({}, 'messages') }}: {{ user.firstName }} {{ user.lastName }}</h5>
                    
                    <form method="post" action="{{ actionUrl }}">
                        <div class="mb-3">
                            <label for="rejection_reason" class="form-label">{{ 'users.actions.reject_reason_label'|trans({}, 'messages') }}</label>
                            <textarea class="form-control" id="rejection_reason" name="rejection_reason" rows="5" required placeholder="{{ 'users.actions.reject_reason_placeholder'|trans({}, 'messages') }}"></textarea>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="{{ returnUrl }}" class="btn btn-secondary">{{ 'users.actions.reject_cancel'|trans({}, 'messages') }}</a>
                            <button type="submit" class="btn btn-danger">{{ 'users.actions.reject_confirm'|trans({}, 'messages') }}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
