{% extends '@!NelmioApiDoc/SwaggerUi/index.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Aumentar el ancho máximo del contenedor principal */
        .swagger-ui .wrapper {
            max-width: 1460px !important;
            padding: 0 60px;
        }

        /* Mayor separación entre módulos (Tags) */
        .swagger-ui .opblock-tag-section {
            margin-bottom: 80px !important;
            padding: 30px;
            background: rgba(255, 255, 255, 0.03); /* Sutil fondo para agrupar */
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Estilizar los títulos de los módulos */
        .swagger-ui .opblock-tag {
            font-size: 32px !important;
            padding: 20px 0 !important;
            margin-bottom: 30px !important;
            border-bottom: 2px solid #49cc90 !important; /* Color acento de swagger */
            color: #fff !important;
            font-family: 'Inter', sans-serif;
            text-transform: uppercase;
            letter-spacing: 2px;
            display: flex;
            align-items: center;
        }

        /* Separación entre bloques de endpoints individuales */
        .swagger-ui .opblock {
            margin-bottom: 16px !important;
            border-radius: 12px !important;
            border: none !important;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
            transition: all 0.3s ease;
        }

        .swagger-ui .opblock:hover {
            transform: scale(1.005);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }

        /* Aumentar padding interno de los resúmenes */
        .swagger-ui .opblock .opblock-summary {
            padding: 15px 25px !important;
        }

        /* Mejorar legibilidad de los textos descriptivos */
        .swagger-ui .opblock .opblock-summary .opblock-summary-description {
            font-size: 15px !important;
            color: rgba(255, 255, 255, 0.8) !important;
            font-weight: 500;
        }

        /* Botón Authorize más visible */
        .swagger-ui .auth-wrapper .authorize {
            padding: 12px 40px !important;
            font-size: 16px !important;
            font-weight: 800 !important;
            border-radius: 10px !important;
            text-transform: uppercase;
            box-shadow: 0 4px 10px rgba(73, 204, 144, 0.3);
        }

        /* Info section - más grande */
        .swagger-ui .info {
            margin: 50px 0 !important;
        }
        .swagger-ui .info .title {
            font-size: 48px !important;
        }
    </style>
{% endblock %}
