{# Variables esperadas:
   - booking (App\Entity\Booking)
   - recipient (App\Entity\User)
   - portalUrl (string)
#}
{% extends 'emails/base.html.twig' %}

{% set patientName = booking.patientUser ? (booking.patientUser.firstName ~ ' ' ~ booking.patientUser.lastName) : '—' %}
{% set proName     = booking.professionalUser ? (booking.professionalUser.firstName ~ ' ' ~ booking.professionalUser.lastName) : '—' %}
{% set startAt     = booking.dateBookingStart ? booking.dateBookingStart|date('Y-m-d H:i') : '—' %}
{% if isProfessional is not defined %}
    {% set isProfessional = (booking.professionalUser and recipient.email == booking.professionalUser.email) %}
{% endif %}

{% block title %}Reserva cancelada{% endblock %}

{% block content %}
    {% if isProfessional %}
        <h2>Reserva cancelada</h2>
        <p>La reserva con {{ patientName }} ha sido cancelada.</p>
    {% else %}
        <h2>Tu reserva fue cancelada</h2>
        <p>Tu reserva con {{ proName }} ha sido cancelada.</p>
    {% endif %}

    <div style="margin: 10px 0 16px; line-height: 1.6;">
        <strong>Consultante:</strong> {{ patientName }}<br>
        <strong>Profesional:</strong> {{ proName }}<br>
        <strong>Fecha y hora (original):</strong> {{ startAt }}<br>
        <strong>Tipo:</strong> {{ booking.type ? ('booking.type.' ~ booking.type.value)|trans : '—' }}
    </div>

    <p>
        Si necesitas agendar una nueva cita, puedes hacerlo desde la plataforma:
    </p>

    <p style="text-align: center; margin-top: 20px;">
        {% if isProfessional %}
            <a href="{{ portalUrl }}/professionals/booking-details/{{ booking.uid }}" class="button" style="color: #ffffff !important;">Ver Detalles de la Reserva</a>
        {% else %}
            <a href="{{ portalUrl }}/professionals/booking-details/{{ booking.uid }}" class="button" style="color: #ffffff !important;">Ver Detalles de la Reserva</a>
        {% endif %}
    </p>

    {% if booking.notes %}
        <p style="color:#666; font-size: 12px; margin-top:14px;"><strong>Notas previas:</strong> {{ booking.notes }}</p>
    {% endif %}
{% endblock %}
