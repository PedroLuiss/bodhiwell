<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8">
		<title>
			{% block title %}Bodhiwell Notification
			{% endblock %}
		</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<style>
			.mail-container {
				max-width: 560px;
				margin: 0 auto;
				font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
				color: #222;
			}
			.card {
				border: 1px solid #eee;
				border-radius: 8px;
				padding: 20px;
				text-align: center;
			}
			h1,
			h2 {
				font-size: 20px;
				margin: 0 0 16px;
				color: #7A9E7E;
			}
			p {
				margin: 10px 0 16px;
				line-height: 1.6;
				color: #555;
			}
			.button {
				display: inline-block;
				padding: 12px 24px;
				border-radius: 6px;
				text-decoration: none;
				background: #7A9E7E;
				color: #ffffff;
				font-weight: bold;
				margin-top: 20px;
			}
			.footer {
				font-size: 12px;
				color: #999;
				margin-top: 30px;
				text-align: center;
			}
		</style>
	</head>
	<body>
		<div class="mail-container">
			<div style="text-align: center; margin-bottom: 20px; background: transparent;">
				<img src="{{ app_url }}/images/logo/Logo-bodhiwell.png" alt="Bodhiwell" style="max-width: 180px; height: auto; background: transparent;">
			</div>
			<div class="card"> {% block content %}{% endblock %}
				</div>
				<div class="footer">
					<p>Bodhiwell Platform</p>
				</div>
			</div>
		</body>
	</html>
